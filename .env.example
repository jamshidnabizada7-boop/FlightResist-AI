# FlightResist AI 2.0 — environment configuration
#
# Copy to `.env` and fill in. Every variable below is OPTIONAL: with none of them
# set, the app runs the deterministic DemoProvider with a deterministic template
# explanation, which is the reproducible demo configuration.

# ---------------------------------------------------------------------------
# Database (Prisma — Postgres for production, SQLite for local dev)
# ---------------------------------------------------------------------------
# Database (Postgres for production; file:./db/custom.db for local SQLite dev)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?connection_limit=5
# DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/dbname  # non-pooled, for migrations
#
# Local SQLite dev: keep the relative form so the repo is portable across
# clones. It is resolved to an absolute path at runtime in src/lib/db.ts,
# which is required for the Next.js standalone build to find the file.
DATABASE_URL=file:./db/custom.db

# ---------------------------------------------------------------------------
# Travel provider selection
# ---------------------------------------------------------------------------
#   demo  — deterministic 42-candidate fixture, SIM-* references, never a real
#           booking. Reproducible; use this for recorded demos.
#   atlas — real `atlas-flight` CLI against the Atlas Sandbox (real fare verify,
#           real order, real payment, real airline PNR).
#   auto  — use atlas when the CLI probe succeeds, else demo.
#
# NOTE: the Atlas Sandbox rate-limits duplicate bookings. Do not loop `atlas`
# mode runs.
ATLAS_MODE=demo

# ---------------------------------------------------------------------------
# LLM explanation layer (EXPLANATION-ONLY — never computes or ranks anything)
# ---------------------------------------------------------------------------
#   auto       — try providers in order using whichever keys are present:
#                dashscope → groq → gemini → openrouter → deterministic template.
#   dashscope  — force Alibaba Cloud Model Studio (preferred, Qwen).
#   qwen       — alias of dashscope.
#   groq | gemini | openrouter — force one specific fallback provider.
#   template   — never call an LLM; use the deterministic template reasoner only.
#
# All providers are called via OpenAI-compatible chat completions. A failing,
# slow (shared 9s budget), or malformed backend falls through to the next, and
# the chain ends at the deterministic template — the pipeline never blocks.
# LLM_PROVIDER=auto

# Preferred: Alibaba Cloud Model Studio (DashScope) — OpenAI-compatible endpoint.
# Create a key at https://bailian.console.alibabacloud.com/
# DASHSCOPE_API_KEY=sk-your-key-here

# Regional endpoint. Default is the international (Singapore) base URL.
# Mainland China: https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# qwen-plus (default) | qwen-max | qwen-turbo
# QWEN_MODEL=qwen-plus

# Fallback 1: Groq (OpenAI-compatible). Default model is Qwen served by Groq.
# GROQ_API_KEY=gsk-your-key-here
# GROQ_MODEL=qwen/qwen3.8-27b

# Fallback 2: Google Gemini via its OpenAI-compatible surface.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Fallback 3: OpenRouter (any model, e.g. qwen/qwen-plus).
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=qwen/qwen-plus

# ---------------------------------------------------------------------------
# === Vercel Deployment ===
# ---------------------------------------------------------------------------
# Set ATLAS_MODE=demo for Vercel (Atlas CLI not available on serverless)
# ATLAS_MODE=demo
#
# DEPLOY_TARGET is only needed for self-hosted (ECS) standalone builds;
# leave it unset on Vercel so `next build` produces a standard build.
# DEPLOY_TARGET=standalone

# ---------------------------------------------------------------------------
# Authentication (NextAuth)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# ---------------------------------------------------------------------------
# Email (SMTP) — required for email verification; falls back to console log
# when SMTP_HOST is not set.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@flightresist.app
