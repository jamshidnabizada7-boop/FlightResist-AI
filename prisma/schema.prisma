generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) Postgres connection for advisory
  // locks; the pooled url is used for regular app queries.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  emailVerified DateTime?
  preferredMode String    @default("DEMO") // "DEMO" or "LIVE"
  createdAt     DateTime  @default(now())
  sessions      Session[]
  accounts      Account[]
  trips         TripSession[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// OAuth account linking (NextAuth PrismaAdapter) — one row per external
// identity (Google, GitHub, ...) linked to a local user.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// FlightResist AI 2.0 — durable session state (in-memory store is live truth,
// this table is the write-through snapshot for restart resilience + demo ledger)
model TripSession {
  id              String   @id // e.g. "TRIP-SIN-NRT-2026"
  state           String
  providerMode    String
  riskScore       Int      @default(0)
  disruption      String? // JSON: DisruptionEvent
  analysis        String? // JSON: RecoveryAnalysis (options, funnel, impact graph, explanation)
  execution       String? // JSON: ExecutionResult
  selectedOption  String?
  disruptionSeq   Int      @default(0) // how many disruptions triggered this session
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Append-only agent reasoning trace (replayed by SSE on reconnect)
model AgentEvent {
  id          Int      @id @default(autoincrement())
  sessionId   String
  seq         Int
  phase       String
  step        String
  title       String
  details     String
  level       String   // info | success | warn | critical | agent
  agent       String?  // Phase 4: TraceActor — SUPERVISOR | IMPACT_REASONER | TRADE_OFF_EXPLAINER | TOOL_ORCHESTRATOR | DETERMINISTIC_ENGINE | OPTIMIZER
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([sessionId, seq])
}

// Recovery execution ledger (persisted history of provider executions)
model ExecutionOrder {
  id              String   @id @default(cuid())
  sessionId       String
  providerMode    String
  proposalId      String
  status          String // SIMULATED | SUCCEEDED | FAILED
  reference       String? // SIM-REV-xxxxx (demo) or provider order id (atlas)
  pnr             String?
  fareKey         String?
  executionTimeMs Int      @default(0)
  steps           String // JSON: ExecutionStep[]
  createdAt       DateTime @default(now())

  @@index([sessionId, createdAt])
}
