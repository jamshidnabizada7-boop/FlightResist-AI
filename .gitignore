# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — block all .env* except the committed template
.env*
!.env.example

# The canonical database is db/custom.db (tracked). The Prisma CLI resolves a
# relative `file:` URL against prisma/schema.prisma, so an unqualified
# `prisma db push` creates a decoy DB here that nothing reads. Use `npm run
# db:push`, which pins DATABASE_URL to the real file, and never commit a decoy.
/prisma/db/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
*.log
dev.log
dev.out.log
test
prompt

server.log
# Scratch git toolchain fetched by the Atlas Skill installer (micromamba +
# conda package cache, ~640 MB). ATLAS_ENVIRONMENT_SETUP.md documents it as
# scratch tooling that does not touch application code. It was committed by
# accident and accounted for 18,351 of 18,507 tracked files.
/.atlas-git/

# Skills directory
/skills/
.vercel

# Temporary test artifacts & builds
.vercel-tmp/
tests/tmp-shots/
tests/tmp-*.mjs
db/custom.db

# Agent workspaces & scratch tooling
.agents/*
!.agents/skills/
.qoder/
.zcode/
.zscripts/
mini-services/
download/
*.pid